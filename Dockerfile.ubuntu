FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/matplotlib ACADEMY_PRODUCTION=1
WORKDIR /app
COPY requirements.txt requirements-postgres.txt ./
RUN pip install --no-cache-dir -r requirements-postgres.txt && useradd --uid 10001 --create-home appuser
COPY app.py gunicorn.conf.py ./
COPY academy ./academy
COPY modules ./modules
COPY templates ./templates
COPY static ./static
COPY deploy ./deploy
RUN mkdir -p instance && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["python", "-m", "deploy.ubuntu_start"]
